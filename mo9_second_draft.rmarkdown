```{r brier_score_decomposition, include=FALSE}
#| cache: true
# Extract polr predicted probs from one completed dataset
d <- complete(mice_cat_results, 1)
polr_fit <- MASS::polr(nperps_cat ~ attacktype1 + weaptype1_cat + targtype1 +
                         region + suicide + nkill + nwound + iyear + iyear_sq,
                       data = d %>% filter(eventid %in% train_ids),
                       Hess = TRUE)

probs <- predict(polr_fit,
                 newdata = d %>% filter(eventid %in% test_ids),
                 type = "probs")

# Multi-class Brier score
truth_matrix <- model.matrix(~ nperps_cat - 1,
                              data = d %>% filter(eventid %in% test_ids))
brier <- mean(rowSums((probs - truth_matrix)^2))
# Sadly this was 0.48
