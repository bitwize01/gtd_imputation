```{r acled_missingness, include=FALSE}
#| cache: true
acled_target_cols <- c("actor1", "actor2", "inter1", "inter2")
acled_target_col_labels <- c("Primary Actor", "Secondary Actor", "Interactor", "Secondary Interactor")

acled_missingness_summary <- acled_clean %>%
  dplyr::select(all_of(acled_target_cols)) %>%
  summarise(across(everything(), function(x) {
    # Calculate percentage where ANY of these conditions are true:
    mean(
      is.na(x) |                        # Standard NA
      x == "" |                         # Empty string
      grepl("^\\s*$", x) |              # String with only whitespace
      grepl("Unidentified", x, ignore.case = TRUE) # Contains "Unidentified"
    ) * 100
  })) %>%
  pivot_longer(everything(), names_to = "Column", values_to = "Missing_Pct")
```

```{r mice_nperps, include=FALSE}
#| cache: true
# Generate full predictor matrix, divide nperps into categorical variable
# Although we don't want to impute on this to avoid colinearity with nperps
gtd_clean <- gtd_clean %>%
  mutate(nperps = if_else(suicide == 1 & is.na(nperps), 1, nperps)) %>%
  mutate(
    nperps_cat = case_when(
      nperps == 1 ~ "Lone Wolf",
      nperps > 1 & nperps <= 5 ~ "Small Cell",
      nperps > 5 ~ "Large Group",
      # Leave as NA where the original nperps is NA
      TRUE ~ NA_character_ 
    ),
    # Improvement 1: quadratic time term to capture non-linear lone-wolf surge
    # post-2014. iyear is fully observed so iyear_sq inherits no missingness.
    iyear_sq = iyear^2
  ) %>%
  # MICE requires categorical targets to be explicitly defined as factors
  mutate(nperps_cat = ordered(nperps_cat, levels = c("Lone Wolf", "Small Cell", "Large Group")))

# Base fields needed for both MICE runs
# Improvement 2: gname added as a passive predictor. Known group names are strongly
# predictive of perpetrator count (ISIL = large cell; NA gname = likely lone wolf).
# Improvement 1: iyear_sq added alongside iyear to capture the non-linear time trend.
base_vars <- c("eventid", "nkill", "nwound", "attacktype1", "weaptype1", "weaptype1_cat", 
               "targtype1", "suicide", "region", "country", "iyear", "iyear_sq",
               "country_txt", "region_txt", "provstate", "gname")

# Categorical variables to factorize
# weaptype1 included so the analysis models produce per-category coefficients
# (weaptype1 is excluded from MICE predictor matrix via vars_to_exclude, so no RF crash risk)
# gname included here: high-cardinality factor, imputed via cart (see below)
factor_vars <- c("attacktype1", "weaptype1", "weaptype1_cat", "targtype1", "suicide", 
                 "region", "country", "country_txt", "region_txt", "provstate", "gname")

# --- Improvement 3: stratified train / test split on observed rows ---
# Stratifying by nperps_cat ensures each class (Lone Wolf / Small Cell / Large Group)
# is proportionally represented in both splits, reducing evaluation variance caused
# by the severe class imbalance (~65% Lone Wolf in the observed data).
# Must be defined before any mice() call so predictor matrices are derived from
# training rows only. test_ids and train_ids are referenced by mice_accuracy downstream.
set.seed(101)
observed_rows    <- gtd_clean %>% filter(!is.na(nperps))
train_row_idx    <- createDataPartition(observed_rows$nperps_cat, p = 0.7, list = FALSE)
train_ids        <- observed_rows$eventid[train_row_idx]
test_ids         <- observed_rows$eventid[-train_row_idx]

# Predictor matrix and method vector derived from training rows only.
# The predictor matrix is structural (variable x variable), not row-dependent,
# so it applies correctly when MICE later runs on the full dataset.
# Using only training rows prevents test-row factor distributions from
# influencing the matrix, closing the leakage identified in the audit.
train_data_cont <- gtd_clean %>%
  filter(eventid %in% train_ids) %>%
  dplyr::select(all_of(base_vars), nperps) %>%
  mutate(across(all_of(factor_vars), as.factor))

dry_run_cont  <- mice(train_data_cont, maxit = 0, printFlag = FALSE)
pred_mat_cont <- dry_run_cont$predictorMatrix
imp_meth_cont <- dry_run_cont$method

imp_meth_cont[imp_meth_cont != ""] <- "rf"
imp_meth_cont[c("nperps", "nkill", "nwound")] <- "pmm"
imp_meth_cont[c("country", "provstate", "gname")] <- "cart" # cart for high-cardinality factors

# "Don't use as a predictor" and "don't impute" are two separate concerns.
# The previous code zeroed both row and column for vars_to_exclude, which caused
# "no covariates found" for any variable with real missingness (country, provstate,
# weaptype1): its row was zeroed while its method was non-empty.

# Step 1 — zero COLUMNS only for variables that must not actively predict others.
# Rows are left intact so these variables can still receive imputations.
never_predict <- c("eventid", "country", "provstate", "country_txt", "region_txt",
                   "weaptype1", "gname")
pred_mat_cont[, never_predict] <- 0

# Step 2 — set method = "" for variables that must not be imputed at all.
# - eventid:           row identifier
# - country_txt / region_txt: plain-text labels, redundant with their numeric factors
# - weaptype1:         has genuine NAs but weaptype1_cat already carries this
#                      information; imputing the raw code is redundant and was the
#                      direct source of the "no covariates" error
never_impute <- c("eventid", "country_txt", "region_txt", "weaptype1")
imp_meth_cont[never_impute] <- ""

# vars_to_exclude is kept for downstream chunks (nperps_cat_mice, mice_accuracy)
vars_to_exclude <- never_predict

# Production MICE: full dataset (all observed + all originally-missing rows)
impute_data_cont <- gtd_clean %>%
  dplyr::select(all_of(base_vars), nperps) %>%
  mutate(across(all_of(factor_vars), as.factor))

# Run Model A: MICE against nperps
# 4 workers x 2 imputations each = 8 total; leaves 4 cores free for OS/RStudio
progressr::handlers("txtprogressbar")
with_progress({
  mice_cont_results <- futuremice(impute_data_cont,
                                  m = 8,
                                  maxit = 20,
                                  method = imp_meth_cont,
                                  predictorMatrix = pred_mat_cont,
                                  parallelseed = 101,
                                  n.core = 4)
})
```

```{r nperps_cat_mice, include=FALSE}
#| cache: true

# Predictor matrix for Model B derived from training rows only (same split as Model A)
train_data_cat <- gtd_clean %>%
  filter(eventid %in% train_ids) %>%
  dplyr::select(all_of(base_vars), nperps_cat) %>%
  mutate(across(all_of(factor_vars), as.factor))

dry_run_cat  <- mice(train_data_cat, maxit = 0, printFlag = FALSE)
pred_mat_cat <- dry_run_cat$predictorMatrix
imp_meth_cat <- dry_run_cat$method
post_cat     <- dry_run_cat$post # Extract the post-processing vector
# This tells MICE to look at the currently imputed values (imp[[j]]), 
# check the original data for suicide == 1, and downgrade "Large Group" guesses.
post_cat["nperps_cat"] <- "imp[[j]][data$suicide[!r[, j]] == 1 & imp[[j]] == 'Large Group'] <- 'Small Cell'"

imp_meth_cat[imp_meth_cat != ""] <- "rf" # Random forest for everything, then overwrite
imp_meth_cat[c("nkill", "nwound")] <- "pmm"
imp_meth_cat[c("nperps_cat")] <- "rf" # Polr unsuitable due to mixed weights at boundries for key predictors
imp_meth_cat[c("country", "provstate", "gname")] <- "cart" # cart for high-cardinality factors

pred_mat_cat[, vars_to_exclude] <- 0   # column zero only — same logic as Model A
imp_meth_cat[never_impute] <- ""        # don't impute identifiers / redundant vars

# Production MICE: full dataset
impute_data_cat <- gtd_clean %>% 
  dplyr::select(all_of(base_vars), nperps_cat) %>%
  mutate(across(all_of(factor_vars), as.factor))

# Run Model B: nperps_cat as factorized binned categorical variable
progressr::handlers("txtprogressbar")
with_progress({
  mice_cat_results <- futuremice(impute_data_cat,
                                 m = 8,
                                 maxit = 10,
                                 method = imp_meth_cat,
                                 predictorMatrix = pred_mat_cat,
                                 post = post_cat,
                                 parallelseed = 101,
                                 n.core = 4)
})
```

```{r nperps_log_models, include=FALSE}
#| cache: true
logistic_models_nperps_cat <- with(mice_cat_results, 
                        glm(nperps_cat == "Lone Wolf" ~ attacktype1 + weaptype1 + targtype1 + suicide + region, 
                            family = binomial))

pooled_results_nperps_cat <- pool(logistic_models_nperps_cat)

logistic_models_nperps <- with(mice_cont_results, 
                        glm(nperps == 1 ~ attacktype1 + weaptype1 + targtype1 + suicide + region, 
                            family = binomial))

pooled_results_nperps <- pool(logistic_models_nperps)
```

```{r introduction_stats, include=FALSE}
#| cache: true
attacks_over_time <- gtd_clean %>%
  filter(iyear >= 2000 & nperps >= 1) %>%
  filter(region_txt %in% c('Eastern Europe', 'Western Europe', 'North America')) %>%
  filter(!(iyear == 2001 & imonth == 9 & iday == 11)) %>% # Exclude 9/11 attacks which badly skew the plot
  mutate(casualties = nkill + nwound) %>%
  mutate(casualties = ifelse(is.na(casualties), 0, casualties)) %>%
  arrange(iyear, imonth, iday) %>%
  group_by(iyear) %>%
  summarise(
    num_attacks = n(),
    num_indiv = sum(nperps == 1, na.rm = TRUE),
    total_casualties = sum(casualties, na.rm = TRUE),
    casualties_indiv = sum(casualties[nperps == 1], na.rm = TRUE),
    ratio = (casualties_indiv / total_casualties)
  ) %>%
  ungroup()
```

# Introduction

The term "lone wolf" was popularized in the late 1990s by white supremacists Tom Metzger and Alex Curtis as part of an encouragement to fellow racists to act alone in committing violent crimes for tactical reasons [@bakker2010lonewolves], fomenting a pivotal shift in the tactics employed of terrorism. From 2003 to 2018, the proportion of individual lone wolf attackers increased from 35.4% to 85%. Casualties inflicted by lone wolves in 2025 accounted for 93% of the total casualties recorded in Western Countries, demonstrating a continuing trend. [@iep2025terrorism]

There is a critical need to examine the differences in tactics and outcomes of lone wolves, however the existing data is not immediately conducive to a quantitative analysis due to 83% of recorded attacks not accurately reporting on the number of perpetrators, making a differentiation of attacks based off the number of perpetrators difficult. Analysis is further confounded by the data being Missing Not At Random (MNAR).

My research evaluates the accuracy of Multiple Imputation by Chained Equations (MICE), a powerful technique that uses tailored prediction methods for every missing column per record. The outcomes of the results of MICE imputation are measured against dataset fusion and listwise deletion approaches, common methods used to improve the accuracy of predictive models. The differences between results demonstrates the implicit bias introduced through imputation and synthesis methods on data that is not missing at random.

I sought to explore the difference in lethality, tactics, and outcomes of individuals performing attacks by themselves as compared to attacks perpetuated by multiple attackers. In producing a lens through which the impact and profile of "Lone Wolves" can be approached by counterterrorism researchers, methods of identification and risk assessment can be performed. I then examined the changes in individual-sized terrorist attacks over time, looking for developing trends in attack types, success rates, and casualties, seeking to explore the rate at which these attacks are increasing in their risk.

Finally, I compare my results against the imputed dataset with the results from the limited data available in the GTD on individual attacks. While the scarcity of this data has historically presented difficulties in analysis, the value in comparing the difference in predictors from the imputed dataset reveals the confounders introduced by MICE, belying the high accuracy results of MICE's predictive model. Throughout this process I seek to ensure the ability for others to reproduce my results, as well as evaluate their validity by applying the Shapley Additive Explanation (SHAP) process to document the weights and reveal additional insight about lone wolf terrorism in comparison to other attack types.

```{r intro_plot}
#| cache: true
#| label: fig1
#| fig-cap: "Attacks and casualties by year in Western Countries, 2000-2020"
plot_data <- attacks_over_time %>%
  arrange(iyear) %>% 
  mutate(
    num_group = num_attacks - num_indiv,
    # Calculates a 3-year trailing average: Current year + previous year + 2 years ago
    ratio_3yr_avg = (ratio + lag(ratio, n = 1) + lag(ratio, n = 2)) / 3
  )
plot_data_long <- plot_data %>%
  dplyr::select(iyear, num_indiv, num_group) %>%
  pivot_longer(cols = c(num_indiv, num_group), 
               names_to = "attack_type", 
               values_to = "count")
scale_factor <- max(plot_data$num_attacks, na.rm = TRUE)

ggplot() +
  geom_col(data = plot_data_long, aes(x = iyear, y = count, fill = attack_type)) +
  geom_line(data = plot_data, aes(x = iyear, y = ratio_3yr_avg * scale_factor, group = 1), 
            color = "black", linewidth = 1) +
  geom_point(data = plot_data, aes(x = iyear, y = ratio_3yr_avg * scale_factor), 
             color = "black", size = 2) +
  scale_y_continuous(
    name = "Total Number of Attacks",
    sec.axis = sec_axis(~ . / scale_factor, name = "Ratio of Casualties by Individuals") 
  ) +
  
  scale_fill_manual(
    values = c("num_group" = "gray70", "num_indiv" = "steelblue"),
    labels = c("num_group" = "Group/Other", "num_indiv" = "Individuals")
  ) +
  labs(
    title = "Terrorist Attacks and Casualty Ratios in EU/NA (2000-2020)",
    subtitle = "Excluding September 11th attacks as outlier data",
    x = "Year",
    fill = "Number of attackers"
  ) +
  theme_minimal() +
  theme(legend.position = "bottom")
```

# Prior Works

The compound societal and economic issues inflicted upon a community by a terrorist attack are profound, leaving lasting scars that affect the stability of a region. Predicting terrorist attacks and establishing a model that connects terrorist actors to outcomes is a much-researched problem with often no clear solution [@wani2024review]. Recent breakthroughs in statistical learning methods have opened new pathways into modeling existing data sources, including more accurate data synthesis mechanism, new opportunities for the fusion and augmentation of data from external sources, and the use of contextual models to refine and establish relationships between data.

Because terrorist attacks are inherently clandestine events often involving deliberate deception to evade law enforcement---particularly in the case of independent "lone wolf" actors---critical details regarding perpetrators, weapons, and exact casualties are frequently obscured or systematically underreported. Consequently, this lack of data is MNAR because the "missingness" is inextricably linked to the nature of the attack itself; the very characteristics that make a covert, low-profile attack successful directly cause the absence of detailed public reporting and the resulting informational voids within the database. This behavior is exemplified in the Global Terrorism Database (GTD), the primary source for my research data. [@GTD2026]

## About the Global Terrorism Database

The systematic quantification of political violence relies upon the structural integrity of longitudinal archives, among which the Global Terrorism Database (GTD) serves as the preeminent unclassified repository for researchers, policymakers, and security analysts [@Abdalsalam2024a]. Originally founded in 1970 by Pinkerton, a private intelligence firm, it has been Maintained by the National Consortium for the Study of Terrorism and Responses to Terrorism (START) since 2001. The GTD documents over 180,000 incidents since 1970, capturing more than 130 variables for contemporary events, ranging from tactical specifics to perpetrator identities and casualty metrics [@GTD2026]. The GTD has been leveraged extensively to produce insightful analysis on the relationship between terrorism, political violence, and civil unrest, with LaFree and Dugan writing several seminal works that show terrorists as rational decision makers who are affected by counterterrorism controls. Despite its breadth of coverage and the wide array of descriptive fields to perform analysis upon, the utility of the GTD is persistently challenged by the "missingness" problem: the presence of null or unknown entries in critical fields such as perpetrator group names, casualty counts, and specific weapon sub-types. These informational voids are not merely random artifacts of data entry but are often the product of systematic biases in media reporting, state-sponsored censorship, or the inherent clandestine nature of non-state actors [@wani2024review]. The GTD codebook takes a measured approach with the inclusion of a terrorist attack, choosing a pathway of preferring inclusion of an attack so long as it is not clearly disqualified, even if the record would have a relatively sparse level of populated fields.

## Analysis and Imputation against the GTD

The modern frontier of data science offers a robust suite of solutions to mitigate information gaps through advanced data imputation [@Azad2025]. Traditional methods such as listwise deletion or dataset fusion introduce signficiant bias in the GTD, skewing attack types in the remaining data. This reflects the MNAR nature of the data results: Bombing attacks are more heavily represented in both the GTD and ACLED, and have a higher amount of missing perpetrator fields.

```{r missingness_bias_test}
#| cache: true
#| label: fig2
#| fig-cap: "Distribution of Attack Types in the Full GTD (2000–2022)"
excluded_types <- c("Unknown", "Unarmed Assault", "Hijacking",
                    "Hostage Taking (Barricade Incident)", "Hostage Taking (Kidnapping)")

attacktype_full <- gtd_full %>%
  filter(!is.na(attacktype1_txt), !attacktype1_txt %in% excluded_types) %>%
  count(attacktype1_txt) %>%
  mutate(pct = n / sum(n) * 100, dataset = "Full GTD")

attacktype_listwise <- gtd_full %>%
  filter(!is.na(nperps), !is.na(attacktype1_txt), !attacktype1_txt %in% excluded_types) %>%
  count(attacktype1_txt) %>%
  mutate(pct = n / sum(n) * 100, dataset = "Listwise Deletion")

attacktype_shared <- shared_events %>%
  filter(!is.na(attacktype1_txt), !attacktype1_txt %in% excluded_types) %>%
  count(attacktype1_txt) %>%
  mutate(pct = n / sum(n) * 100, dataset = "GTD-ACLED")

attacktype_dist <- bind_rows(attacktype_full, attacktype_listwise, attacktype_shared) %>%
  mutate(
    attacktype1_txt = factor(attacktype1_txt,
      levels = attacktype_full %>% arrange(pct) %>% pull(attacktype1_txt)),
    dataset = factor(dataset,
      levels = c("Full GTD", "Listwise Deletion", "GTD-ACLED"))
  )

ggplot(attacktype_dist, aes(x = attacktype1_txt, y = pct, fill = dataset)) +
  geom_col(position = "dodge") +
  geom_text(aes(label = sprintf("%.1f%%", pct)),
            position = position_dodge(width = 0.9), hjust = -0.1, size = 2.8) +
  coord_flip() +
  scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
  scale_fill_manual(values = c("Full GTD"                          = "steelblue",
                                "Listwise Deletion" = "tomato",
                                "GTD-ACLED"            = "forestgreen")) +
  labs(
    x = NULL,
    y = "Percentage of Attacks (%)",
    title = "Comparison of bias introduced by\nListwise Deletion and Dataset Fusion",
    fill = NULL
  ) +
  theme_minimal() +
  theme(
    legend.position = "right",
    plot.title = element_text(hjust = 0)
  )
```

As an alternative, the application of domain-specific Natural Language Processing (NLP) and meta-learning ensemble architectures is emerging as the gold standard for data recovery in conflict event databases. By leveraging extractive transformer models like ConfliBERT to analyze unstructured event summaries and employing Meta-Imputation Balanced (MIB) frameworks to synthesize predictions from multiple algorithmic sources, researchers have extracted contextual information by collating common attacks with synthesized data to produce models capable of highly accurately predicting group name [@Azad2025]. However, these papers and other quantitative analysis papers more interested in exploring the technical implementation and maximum efficacy of their imputation process often omit all but the largest terrorist groups, to produce groups of results that can be broadly analyzed using these contextual models [@Pan2021], focusing on groups with over 1000 documented attacks. The result is a model with a highly predictive accuracy against only a small subset of the actual records in the dataset, with impacted external validity. As an example from 2024, Abdalsalam et al documented the use of the BiGRU contextual model to identify terrorist groups with high accuracy against only terrorist groups with 500 or more documented attacks, resulting a total group size of 36 terrorist groups out of the 3,767 groups described in the full GTD dataset, raising questions on the accuracy of the approach on real-world data, particularly present data from emerging threats.

Wani explores the mechanisms of missing data completely at random (MCAR), when the observed data is unevenly missing at random (MAR) and missing not at random (MNAR) in which the missingness is a result of a confounding effect [@wani2024review], as is the case in the GTD, where information collection conditions rely on public reports, with records on unsuccessful, zero-casualty attacks generally containing more missing fields. In their review of potential imputation frameworks, Wani evaluates recovery strategies such as Multiple Imputation by Chained Equations (MICE), Random Forests, and Generative Adversarial Networks. Wani advocates for task-specific evaluation metrics such as classification accuracy or measuring the precision of regression models for specific key values of the treatment variable. These more nuanced methods better describe model fit and field missingness as compared to relying solely on standard error calculations such as Root Mean Squared Error (RMSE) when NMAR data is present. In high-dimensional MNAR datasets such as the GTD, fields are left blank or intentionally flagged as unknown if there is not clear consensus, even if some potential information points toward a value. Indeed, Abdasalam notes in their 2024 article exploring the missingness of the group name field that a value being left unknown is sometimes a conscious choice, stating "This gap in research may stem from the complex and dynamic nature of terrorist groups, which frequently evolve, change names, merge, or disband, thereby complicating the creation of accurate and current classification and prediction models." [@Abdalsalam2024a]. As a measure of this approach, I include in this paper an analysis of the predictors involved in identifying individual attacks, along with a comparison of the magnitude of the predictors against un-imputed data. While MNAR data cannot be observed directly, this approach can reveal the confounding effect it introduces.

Reductions in the analyzed dataset have also prevailed to produce statistically significant predictions at the cost of the ability of the results to be interpreted against excluded or newly-added data. Abdalsalam has had success with highly predictive contextual prediction models such as DistilBERT [@Abdalsalam2021a] or extractive text classifiers such as word2vec [@Abdalsalam2024], resulting in models capable of identifying attack type or location with a high degree of accuracy, although the research did exclude about 73% of the dataset to missing or insufficiently long descriptions. This exposes the limitations of predicting a 'freeform' field such as group name using a statistical model without a limited Retrieval Augmented Generation (RAG) ability to narrow the search space of the contextual model. The limitation of these approaches is the significant setup time and the reliance on externally-available related sources. Using prepared media libraries or archives of social media records can provide critical context, but also introduces significant setup and configuration steps, as well as mandating extensive comparison testing to determine the accuracy (or bias, if improperly configured) granted by the RAG.

New compound fields can be generated against the GTD by analyzing text fields alongside restricting datasets to natural groups. Bridgelall describes an empirical text mining algorithm to produce a new "motive" field that allows analysts to categorize attacks based on underlying sentiments such as anti-government "rule," race, or religion. The study employs advanced techniques like k-means co-clustering and nonlinear projections to visualize how these motives statistically intersect with specific tactics and targets [@bridgelall2022unsupervised]. This can allow the conversion of free-form and numerical fields into factorized categories, allowing for additional analysis pathways.

## An alternative source for conflict data: ACLED

While the GTD's development at START was designed as an archival system tracking the social and political relationships to terrorism, The Armed Conflict Location and Event Data (ACLED) database provides valuable context to the GTD when collated by location and time. The ACLED includes details on news sources describing the attribution [@ACLEDcodebook2025] information as well as detailed actor information. While the ACLED contains nearly significantly more entries for the same time period, it is important to note the difference in membership criterion. The GTD contains information on confirmed non-state terrorist attacks where money was not the primary goal of the attack [@GTD2007introducing]; the ACLED has a much broader selection criterion including state actors and independent militias, as well as protest and riots that would be excluded from the GTD. A joined database of shared records brings the intersecting rows down to 20,782 records, removing 118,850 records from the potential comparison pool. In an effort to explore the confounding effect of the omission of the records not present in both datasets, my imputation workflow will be run on the standalone GTD dataset as well as a joined dataset, giving opportunities for accuracy comparisons between the two, holding the workflow process consistent.

## Additional imputation methods and frontier models

Additional imputation methods used to analyze other datasets are described in Appendix 1. These methods have potential to be used against the GTD, but have not yet been thoroughly investigated. Further, my research did not uncover another published effort imputing the number of perpetrators, likely due to the difficulty of imputing MNAR data on a field with such a high degree of missingness. As a result, I attempted my own imputation effort using a customized MICE approach to determine the potential accuracy and application of such an imputation against highly missing, MNAR data such as the number of perpetrators.

# Methods

High-quality, varied data is the often-sought, rarely-acquired state for quantitative analysis. Imputing rows within the GTD is no exception, and I sought a method that would allow analysts to infer and predict multiple fields simultaneously. As a result, MICE is a natural candidate as compared to more advanced methods that are tailored to impute only a single variable at a time.

## Data Preperation

In the case of the GTD, the relationships between attack types and number of perpetrators aren't represented similarly prior to the year 2000. As a result I reduced the records of the GTD dataset for my analysis to only records from 2000 to 2020. The records with a large number of perpetrators  and I also excluded records with 50 or more perpetrators, as these records heavily skew the data. For example, the proportion of armed assaults are 29% higher than the average across all attacks, and bombings perpetrated by very large groups occur 37.5% less. I also combined the weapon type listings into a reduced number of categories, as the extreme under-representation of certain weapon types such as radiological attacks cause imputation methods to fail due to quasi-complete separation.

After the dataset had been scoped, I examined the remaining 138,000 records. Of these, 22,065 records (15.9%) had a defined number of perpetrators value, with 8,520 (5.9%) records having a single attacker. These rows comprise my test and training dataset. When implementing MICE against the GTD, I found several techniques to improve the performance and/or accuracy of the imputation process. One of the key performance improvements was imputing the continuous number of perpetrators variable as a categorical factor describing the group size more generally. 

Examining the GTD data and existing research, I identified that the GTD data spanning from 2000-2020 has a number of critical fields such as Number of perpetrators, Group name and casualty information that have a high level of missingness. These fields are my primary candidates for imputation, and group name in particular has value in identifying not only groups involved, but also in establishing which attacks currently defined as "unknown" could instead be attributed to independent "lone wolf" attackers, the propensity of which is increasing over time and represents a significant threat for counterterrorism law enforcement [@bakker2010lonewolves].

```{r missingness_plot}
#| cache: true
