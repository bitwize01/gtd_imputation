gtd_full <- read.csv(file.path("Data", "globalterrorismdb_0522dist.csv"), fileEncoding = "latin1")
# or try fileEncoding = "windows-1252" if latin1 leaves weird artifacts
acled_full <- read.csv(file.path("Data", "ACLED_Data_2026-02-08.csv"))
