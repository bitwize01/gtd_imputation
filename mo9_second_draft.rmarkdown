```{r tipping_point_estimation, include=FALSE}
#| cache: true
deltas <- c(0, 0.5, 1, 1.5, 2)   # plausible upward shifts in nperps

tipping_results <- lapply(deltas, function(d) {
  # Shift nperps in each of the m completed datasets directly, avoiding mice.mids
  shifted_fits <- lapply(seq_len(mice_cont_results$m), function(i) {
    dat <- complete(mice_cont_results, i) %>%
      mutate(nperps = as.numeric(nperps) + d)
    glm(nperps == 1 ~ attacktype1 + weaptype1_cat + targtype1 + region + suicide,
        family = binomial, data = dat)
  })

  pooled <- pool(shifted_fits)

  tidy(pooled, conf.int = TRUE, exponentiate = TRUE) %>%
    mutate(delta = d)
})

bind_rows(tipping_results) %>%
  filter(term == "suicide1") %>%   # or whichever coefficient is key
  dplyr::select(delta, estimate, conf.low, conf.high)
# If OR for lone-wolf status remains significantly above 1 even at delta = 2 (i.e., all imputed perpetrators are shifted 2 people higher), conclusion is robust to MNAR.
```

```{r mice_pattern_analysis, include=FALSE}
#| cache: true
mice::md.pattern(gtd_clean %>%
  dplyr::select(nperps, nkill, nwound, gname, attacktype1, region),
  rotate.names = TRUE)

# Pattern analysis with md.pattern() shows you the joint missingness structure across variables. For nperps specifically, patterns where nkill is also missing at the same time suggest the event was poorly documented overall — consistent with a structural MAR mechanism (low-documentation events → everything missing). Patterns where nkill is observed but nperps is not are more consistent with MNAR (the attack was observed, but the perpetrator count was deliberately withheld or unknowable):
```

